# Cloudflare Pages _headers

# 1. Global security & browser policy headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# 2. HTML: fresh delivery on every deploy
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/work/*
  Cache-Control: public, max-age=0, must-revalidate

# 3. Static assets: 1-year immutable caching for instant repeat loads
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 4. Stylesheets & Scripts: 7-day edge cache with background revalidation
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
