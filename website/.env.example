# Contact form configuration — copy to .env.local for local work, or set these
# as Environment Variables in the Vercel project settings.
#
# Until both RESEND_API_KEY and CONTACT_TO are set, POST /api/contact answers
# 503 and the page tells the visitor to email instead. It never fakes success.

# From https://resend.com/api-keys — a sending key, not a full-access key.
RESEND_API_KEY=

# Where enquiries are delivered. Comma-separate for more than one.
CONTACT_TO=hello@girgitlabs.com

# Optional. Must be a sender domain verified in Resend. On the Resend sandbox
# this can only be onboarding@resend.dev, which will only deliver to the address
# that owns the Resend account — verify girgitlabs.com before going live.
# CONTACT_FROM=Girgit Labs <hello@girgitlabs.com>
