# Cloudflare Pages _headers

# 1. Global security & browser policy headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# 2. HTML: fresh delivery on every deploy
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/work/*
  Cache-Control: public, max-age=0, must-revalidate

# 3. Static assets: 1-year immutable caching for instant repeat loads
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 4. Stylesheets & Scripts: cached for a year, like the assets. Every page loads them with a version
#    (style.css?v=3.11.3, and every JS import carries one too), and the HTML is always fresh, so a new
#    version is a new URL and is fetched at once. Rule: whenever you change a .css or .js file, bump its
#    ?v= everywhere it is referenced (index.html, work/*/index.html, 404.html, and the imports in js/).
#    Before this, the browser re-checked all ~30 files with the server on every visit.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# 5. The plain-text summaries for AI assistants (llms.txt): UTF-8, so the Hindi reads correctly; refreshed daily.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
